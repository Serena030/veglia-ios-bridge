# Copy to .env and replace every change-me value.
VEGLIA_TOKEN=change-me-to-a-long-random-string
VEGLIA_HOST=127.0.0.1
VEGLIA_PORT=8513
VEGLIA_DATA_DIR=./data

# One hook call per App session after this many minutes.
VEGLIA_WATCH_AFTER_MIN=15
# Optional executable. It receives one JSON object on stdin.
# VEGLIA_WATCH_HOOK=/home/me/wake-my-companion.sh

# Used by: python3 veglia_ios.py summon
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=change-me@example.com
SMTP_PASSWORD=change-me-to-an-app-password
SUMMON_MAIL_TO=change-me@example.com
VEGLIA_SUMMON_SUBJECT=[Veglia] Summon


